{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/run-tests-on-src-change.mjs",
            "timeout": 120,
            "statusMessage": "Running tests (src/ or Skill changed)..."
          }
        ]
      }
    ]
  }
}
